{
  "name": "@suifei/dsh-ai-team",
  "version": "0.3.69",
  "type": "module",
  "description": "文渊阁 (Wenyuan Pavilion) — AI Team mode for DeepSeek Harness: concurrent projects, owned tasks, threads, inbox and an append-only team ledger",
  "license": "MIT",
  "author": "suifei",
  "homepage": "https://github.com/suifei/dsh-ai-team#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/suifei/dsh-ai-team.git"
  },
  "bugs": {
    "url": "https://github.com/suifei/dsh-ai-team/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-team",
    "multi-agent",
    "agent-team",
    "task-ledger",
    "wenyuan"
  ],
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "lib/**/*.js",
    "lib/vendor/skillopt/scripts/**/*",
    "lib/vendor/skillopt/skillopt_sleep/**/*",
    "lib/vendor/skillopt/requirements.txt",
    "lib/vendor/skillopt/LICENSE",
    "skills/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
